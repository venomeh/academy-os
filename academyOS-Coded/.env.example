# Convex Deployment (populated by `npx convex dev`)
CONVEX_DEPLOYMENT=dev:your-convex-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-convex-deployment.convex.site

# ---------------------------------------------------------------------------
# Convex Dashboard / Deployment Environment Variables
# Set these via `npx convex env set <NAME> <VALUE>` or in the Convex Dashboard:
# ---------------------------------------------------------------------------
# SITE_URL=http://localhost:3000
# APP_URL=http://localhost:3000
# JWT_PRIVATE_KEY=...
# JWKS=...
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL="AcademyOS <noreply@example.com>"
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# STRIPE_CURRENCY=pkr
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# CHAT_DAILY_LIMIT=30
# REMINDER_AI_PERSONALIZE=false

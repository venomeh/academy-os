SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CURRENCY=pkr

RESEND_API_KEY=re_your_resend_api_key

APP_URL=https://<YOUR_BUBBLE_APP>.bubbleapps.io/version-test
# Checkout returns: {APP_URL}/pay_result?status=success|cancel
# Email pay links go to /functions/v1/create-checkout?t=<token> (302 → Stripe)
RESEND_FROM_EMAIL=AcademyOS <noreply@example.com>

# Put the real key in Supabase Edge Function secrets, not in Bubble.
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
# Remarks drafts use OPENROUTER_MODEL. Chatbot must NOT fall back to this.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Parent chatbot. Set this Edge Function secret to a non-reasoning chat model.
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
CHAT_DAILY_LIMIT=30

# Cloudflare R2 — set the same four names in Edge Function secrets
# (Supabase Dashboard → Edge Functions → Secrets), not only in this file.
# Endpoint looks like https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=academyos-files
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Shared secret for pg_cron → run-finance-jobs (not a user JWT).
# Set the same value in Supabase Edge Function secrets.
CRON_SECRET=your_random_32_byte_hex_cron_secret
